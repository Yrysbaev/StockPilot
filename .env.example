# QuickBooks / Intuit OAuth (from https://developer.intuit.com)
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local or any file containing real secrets.

QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret

# Match API host to the company you authorize: true (default) = sandbox API; false = production (live) QuickBooks
# QUICKBOOKS_SANDBOX=false

# Optional: app base URL for OAuth redirect (used in callback to build redirect_uri)
# NEXT_PUBLIC_APP_URL=http://localhost:3000